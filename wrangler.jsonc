{
  "name": "filmcraft-academy",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PROGRESS", "class_name": "ProgressStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProgressStore"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
